{
  "manifest_version": 3,
  "name": "Time Tracker",
  "version": "2.0.0",
  "description": "Track time spent on tasks: start, pause, resume, edit, filter by project and export to CSV.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "identity.email",
    "alarms",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Time Tracker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
